<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Уведомления о ходе загрузки (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 14+: User-Initiated Data Transfer Job — основной путь. -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <!-- Android 13 и ниже: foreground service как запасной путь. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 0.4.0: воспроизведение (в том числе «Слушать») с уведомлением MediaSession. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Плеер: не гасить экран во время просмотра. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Только для установки обновления NOX, которое пользователь сам запросил. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".NoxApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nox.Starting"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Nox.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- «Поделиться» ссылкой (одной или несколькими) из VK / браузера прямо в NOX. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Один экземпляр плеера в своей задаче: корректный вход и выход из PiP. -->
        <activity
            android:name=".player.PlayerActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.nox.offline.player"
            android:excludeFromRecents="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Nox.Player" />

        <!-- 0.4.0: MediaSession поверх единственного плеера NOX. -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Android 14+: UIDT job. Права BIND_JOB_SERVICE есть только у системы. -->
        <service
            android:name=".downloader.TransferJobService"
            android:exported="true"
            tools:targetApi="34"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Android 13 и ниже: foreground service типа dataSync. -->
        <service
            android:name=".downloader.TransferForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".downloader.NotificationActionReceiver"
            android:exported="false" />

        <!-- Итог установки обновления от PackageInstaller. -->
        <receiver
            android:name=".updates.InstallStatusReceiver"
            android:exported="false" />

        <!-- Пакет заменён новой версией: защищённый системный broadcast. -->
        <receiver
            android:name=".updates.PackageReplacedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- «Поделиться файлом»: только content://, без выдачи путей. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
